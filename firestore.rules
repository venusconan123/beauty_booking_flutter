rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function bookingUsesVoucher(bookingId, voucherId) {
      let booking = getAfter(
          /databases/$(database)/documents/bookings/$(bookingId)).data;
      return (booking.keys().hasAll(['voucher']) &&
              booking.voucher is map &&
              booking.voucher.id == voucherId) ||
          (booking.keys().hasAll(['voucherIds']) &&
           booking.voucherIds is list &&
           voucherId in booking.voucherIds);
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() &&
          request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if admin();
        allow update, delete: if false;
      }

      match /vouchers/{voucherId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create, delete: if admin();
        allow update: if admin() ||
            (signedIn() &&
             request.auth.uid == userId &&
             resource.data.isActive == true &&
             resource.data.isUsed == false &&
             request.resource.data.isUsed == true &&
             request.resource.data.usedBookingId is string &&
             request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isUsed', 'usedBookingId', 'usedAt', 'updatedAt']) &&
             getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)).data.userId ==
                 request.auth.uid &&
             bookingUsesVoucher(
                 request.resource.data.usedBookingId, voucherId));
      }
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /hairstyles/{hairstyleId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.type in ['employee', 'review'];
      allow read, update, delete: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /support_chats/{userId} {
      allow read: if signedIn() &&
          (request.auth.uid == userId || admin());
      allow create: if signedIn() &&
          request.resource.data.userId == userId &&
          (request.auth.uid == userId || admin());
      allow update: if signedIn() &&
          resource.data.userId == userId &&
          request.resource.data.userId == userId &&
          (request.auth.uid == userId || admin());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create: if signedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.content is string &&
            request.resource.data.content.size() > 0 &&
            request.resource.data.content.size() <= 2000 &&
            ((request.auth.uid == userId &&
              request.resource.data.senderRole == 'user') ||
             (admin() && request.resource.data.senderRole == 'admin'));
        allow update, delete: if false;
      }
    }

    match /voucher_templates/{voucherId} {
      allow read: if signedIn();
      allow create, delete: if admin();
      allow update: if admin() ||
          (signedIn() &&
           resource.data.isActive == true &&
           resource.data.usedCount is int &&
           resource.data.usageLimit is int &&
           resource.data.usedCount < resource.data.usageLimit &&
           request.resource.data.usedCount == resource.data.usedCount + 1 &&
           request.resource.data.lastBookingId is string &&
           request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['usedCount', 'lastBookingId', 'updatedAt']) &&
           getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBookingId)).data.userId ==
               request.auth.uid &&
           bookingUsesVoucher(
               request.resource.data.lastBookingId, voucherId));

      match /redemptions/{userId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create: if signedIn() &&
            request.auth.uid == userId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.bookingId is string &&
            getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId ==
                request.auth.uid &&
            bookingUsesVoucher(
                request.resource.data.bookingId, voucherId);
        allow update, delete: if admin();
      }
    }

    match /reviews/{bookingId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId ==
              request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.status ==
              'completed';

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['barberRating', 'salonRating', 'comment', 'updatedAt']);

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
          (resource.data.userId == request.auth.uid || admin());

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.payment.choice in ['pay_now', 'pay_later'] &&
          ((request.resource.data.payment.choice == 'pay_later' &&
              request.resource.data.status == 'confirmed') ||
           (request.resource.data.payment.choice == 'pay_now' &&
              request.resource.data.status == 'pending')) &&
          request.resource.data.payment.provider == 'vnpay' &&
          request.resource.data.payment.environment == 'sandbox' &&
          request.resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.amount ==
              request.resource.data.totalPrice;

      allow update: if admin() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in
              ['pending', 'confirmed', 'completed', 'cancelled'];

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          (resource.data.status == 'pending' ||
           (resource.data.status == 'confirmed' &&
            resource.data.payment.choice == 'pay_later' &&
            resource.data.payment.status == 'unpaid')) &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']);

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          resource.data.status in ['pending', 'confirmed'] &&
          request.resource.data.status == resource.data.status &&
          resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.provider ==
              resource.data.payment.provider &&
          request.resource.data.payment.environment ==
              resource.data.payment.environment &&
          request.resource.data.payment.choice ==
              resource.data.payment.choice &&
          request.resource.data.payment.diff(resource.data.payment)
              .affectedKeys().hasOnly(['amount']) &&
          request.resource.data.payment.amount ==
              request.resource.data.totalPrice &&
          request.resource.data.services is list &&
          request.resource.data.services.size() > 0 &&
          request.resource.data.serviceIds is list &&
          request.resource.data.totalDurationMinutes > 0 &&
          request.resource.data.originalPrice >= 0 &&
          request.resource.data.discountAmount == 0 &&
          request.resource.data.totalPrice ==
              request.resource.data.originalPrice &&
          request.resource.data.voucherIds.size() == 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'serviceIds', 'services', 'originalPrice',
                'discountAmount', 'totalPrice', 'totalDurationMinutes',
                'slotIds', 'payment', 'updatedAt'
              ]);

      allow delete: if false;
    }

    match /booking_slots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn() &&
          (resource.data.userId == request.auth.uid || admin());

      allow update: if false;
    }

    match /payment_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
