rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function verifiedOrLegacyUser() {
      let profilePath =
          /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() &&
          exists(profilePath) &&
          (request.auth.token.email_verified == true ||
           !get(profilePath).data.keys()
               .hasAll(['requiresEmailVerification']) ||
           get(profilePath).data.requiresEmailVerification != true);
    }

    function bookingUsesVoucher(bookingId, voucherId) {
      let booking = getAfter(
          /databases/$(database)/documents/bookings/$(bookingId)).data;
      return (booking.keys().hasAll(['voucher']) &&
              booking.voucher is map &&
              booking.voucher.id == voucherId) ||
          (booking.keys().hasAll(['voucherIds']) &&
           booking.voucherIds is list &&
           voucherId in booking.voucherIds);
    }

    function validNewUser(userId) {
      return signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'name', 'email', 'phone', 'requiresEmailVerification',
            'emailVerified', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 2 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.email is string &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.phone is string &&
          request.resource.data.phone.matches('^0[0-9]{9}$') &&
          request.resource.data.requiresEmailVerification == true &&
          request.resource.data.emailVerified == false &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
    }

    function validOwnProfileUpdate(userId) {
      return signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 2 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.matches('^0[0-9]{9}$') &&
          request.resource.data.updatedAt is timestamp;
    }

    function validEmailVerificationUpdate(userId) {
      return signedIn() &&
          request.auth.uid == userId &&
          request.auth.token.email_verified == true &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['emailVerified', 'emailVerifiedAt', 'updatedAt']) &&
          request.resource.data.emailVerified == true &&
          request.resource.data.emailVerifiedAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
    }

    function validBookingCreate() {
      return verifiedOrLegacyUser() &&
          request.resource.data.keys().hasAll([
            'userId', 'salonId', 'barberId', 'serviceIds', 'services',
            'appointmentAt', 'originalPrice', 'discountAmount', 'totalPrice',
            'totalDurationMinutes', 'slotIds', 'status', 'payment',
            'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.salonId is string &&
          request.resource.data.salonId.size() > 0 &&
          request.resource.data.barberId is string &&
          request.resource.data.barberId.size() > 0 &&
          request.resource.data.serviceIds is list &&
          request.resource.data.serviceIds.size() > 0 &&
          request.resource.data.serviceIds.size() <= 10 &&
          request.resource.data.services is list &&
          request.resource.data.services.size() ==
              request.resource.data.serviceIds.size() &&
          request.resource.data.appointmentAt is timestamp &&
          request.resource.data.appointmentAt > request.time &&
          request.resource.data.originalPrice is number &&
          request.resource.data.originalPrice > 0 &&
          request.resource.data.discountAmount is number &&
          request.resource.data.discountAmount >= 0 &&
          request.resource.data.totalPrice is number &&
          request.resource.data.totalPrice > 0 &&
          request.resource.data.originalPrice ==
              request.resource.data.totalPrice +
              request.resource.data.discountAmount &&
          request.resource.data.totalDurationMinutes is int &&
          request.resource.data.totalDurationMinutes > 0 &&
          request.resource.data.slotIds is list &&
          request.resource.data.slotIds.size() > 0 &&
          request.resource.data.slotIds.size() <= 48 &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.payment is map &&
          request.resource.data.payment.keys().hasAll([
            'choice', 'provider', 'environment', 'status', 'amount'
          ]) &&
          request.resource.data.payment.choice in ['pay_now', 'pay_later'] &&
          ((request.resource.data.payment.choice == 'pay_later' &&
              request.resource.data.status == 'confirmed') ||
           (request.resource.data.payment.choice == 'pay_now' &&
              request.resource.data.status == 'pending')) &&
          request.resource.data.payment.provider == 'vnpay' &&
          request.resource.data.payment.environment == 'sandbox' &&
          request.resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.amount ==
              request.resource.data.totalPrice;
    }

    function validSlotCreate(slotId) {
      let slot = request.resource.data;
      let booking = getAfter(
          /databases/$(database)/documents/bookings/$(slot.bookingId)).data;
      return slot.keys().hasOnly([
            'bookingId', 'userId', 'salonId', 'barberId', 'slotAt', 'createdAt'
          ]) &&
          slot.bookingId is string &&
          slot.bookingId.size() > 0 &&
          slot.userId == request.auth.uid &&
          slot.salonId == booking.salonId &&
          slot.barberId == booking.barberId &&
          slot.slotAt is timestamp &&
          slot.createdAt is timestamp &&
          booking.userId == request.auth.uid &&
          booking.slotIds is list &&
          slotId in booking.slotIds;
    }

    function validOwnSlotDelete(slotId) {
      let booking = getAfter(
          /databases/$(database)/documents/bookings/$(resource.data.bookingId)).data;
      return signedIn() &&
          resource.data.userId == request.auth.uid &&
          (booking.status == 'cancelled' ||
           !(slotId in booking.slotIds));
    }

    match /users/{userId} {
      allow create: if validNewUser(userId);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if validOwnProfileUpdate(userId) ||
          validEmailVerificationUpdate(userId);

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if admin();
        allow update, delete: if false;
      }

      match /vouchers/{voucherId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create, delete: if admin();
        allow update: if admin() ||
            (signedIn() &&
             request.auth.uid == userId &&
             resource.data.isActive == true &&
             resource.data.isUsed == false &&
             request.resource.data.isUsed == true &&
             request.resource.data.usedBookingId is string &&
             request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isUsed', 'usedBookingId', 'usedAt', 'updatedAt']) &&
             getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)).data.userId ==
                 request.auth.uid &&
             bookingUsesVoucher(
                 request.resource.data.usedBookingId, voucherId));
      }
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /app_settings/{settingId} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /hairstyles/{hairstyleId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
          request.resource.data.reporterId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.type in ['employee', 'review'];
      allow read, update, delete: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /support_chats/{userId} {
      allow read: if signedIn() &&
          (request.auth.uid == userId || admin());
      allow create: if signedIn() &&
          request.resource.data.userId == userId &&
          (request.auth.uid == userId || admin());
      allow update: if signedIn() &&
          resource.data.userId == userId &&
          request.resource.data.userId == userId &&
          (request.auth.uid == userId || admin());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create: if signedIn() &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.content is string &&
            request.resource.data.content.size() > 0 &&
            request.resource.data.content.size() <= 2000 &&
            ((request.auth.uid == userId &&
              request.resource.data.senderRole == 'user') ||
             (admin() && request.resource.data.senderRole == 'admin'));
        allow update, delete: if false;
      }
    }

    match /voucher_templates/{voucherId} {
      allow read: if signedIn();
      allow create, delete: if admin();
      allow update: if admin() ||
          (signedIn() &&
           resource.data.isActive == true &&
           resource.data.usedCount is int &&
           resource.data.usageLimit is int &&
           resource.data.usedCount < resource.data.usageLimit &&
           request.resource.data.usedCount == resource.data.usedCount + 1 &&
           request.resource.data.lastBookingId is string &&
           request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['usedCount', 'lastBookingId', 'updatedAt']) &&
           getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.lastBookingId)).data.userId ==
               request.auth.uid &&
           bookingUsesVoucher(
               request.resource.data.lastBookingId, voucherId));

      match /redemptions/{userId} {
        allow read: if signedIn() &&
            (request.auth.uid == userId || admin());
        allow create: if signedIn() &&
            request.auth.uid == userId &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.bookingId is string &&
            getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId ==
                request.auth.uid &&
            bookingUsesVoucher(
                request.resource.data.bookingId, voucherId);
        allow update, delete: if admin();
      }
    }

    match /reviews/{bookingId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId ==
              request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.status ==
              'completed';

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['barberRating', 'salonRating', 'comment', 'updatedAt']);

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
          (resource.data.userId == request.auth.uid || admin());

      allow create: if signedIn() && validBookingCreate();

      allow update: if admin() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in
              ['pending', 'confirmed', 'completed', 'cancelled'];

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          (resource.data.status == 'pending' ||
           (resource.data.status == 'confirmed' &&
            resource.data.payment.choice == 'pay_later' &&
            resource.data.payment.status == 'unpaid')) &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']);

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          resource.data.status in ['pending', 'confirmed'] &&
          request.resource.data.status == resource.data.status &&
          resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.provider ==
              resource.data.payment.provider &&
          request.resource.data.payment.environment ==
              resource.data.payment.environment &&
          request.resource.data.payment.choice ==
              resource.data.payment.choice &&
          request.resource.data.payment.diff(resource.data.payment)
              .affectedKeys().hasOnly(['amount']) &&
          request.resource.data.payment.amount ==
              request.resource.data.totalPrice &&
          request.resource.data.services is list &&
          request.resource.data.services.size() > 0 &&
          request.resource.data.serviceIds is list &&
          request.resource.data.totalDurationMinutes > 0 &&
          request.resource.data.originalPrice >= 0 &&
          request.resource.data.discountAmount == 0 &&
          request.resource.data.totalPrice ==
              request.resource.data.originalPrice &&
          request.resource.data.voucherIds.size() == 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'serviceIds', 'services', 'originalPrice',
                'discountAmount', 'totalPrice', 'totalDurationMinutes',
                'slotIds', 'payment', 'updatedAt'
              ]);

      allow delete: if false;
    }

    match /booking_slots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn() && validSlotCreate(slotId);

      allow delete: if admin() || validOwnSlotDelete(slotId);

      allow update: if false;
    }

    match /payment_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
