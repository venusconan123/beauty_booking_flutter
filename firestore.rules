rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow create, read, update: if signedIn() &&
          request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if admin();
        allow update, delete: if false;
      }
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /hairstyles/{hairstyleId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /reviews/{bookingId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId ==
              request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.status ==
              'completed';

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.barberRating is int &&
          request.resource.data.barberRating >= 1 &&
          request.resource.data.barberRating <= 5 &&
          request.resource.data.salonRating is int &&
          request.resource.data.salonRating >= 1 &&
          request.resource.data.salonRating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 500 &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['barberRating', 'salonRating', 'comment', 'updatedAt']);

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
          (resource.data.userId == request.auth.uid || admin());

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.payment.provider == 'vnpay' &&
          request.resource.data.payment.environment == 'sandbox' &&
          request.resource.data.payment.status == 'unpaid' &&
          request.resource.data.payment.amount ==
              request.resource.data.totalPrice;

      allow update: if admin() &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in
              ['pending', 'confirmed', 'completed', 'cancelled'];

      allow update: if signedIn() &&
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    match /booking_slots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn() &&
          (resource.data.userId == request.auth.uid || admin());

      allow update: if false;
    }

    match /payment_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
